# Neon connection string (Neon console → Connect → Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
# Google OAuth client IDs whose ID tokens are accepted, comma-separated.
# The apps request tokens for the *Web* client ID, so that one is required.
GOOGLE_CLIENT_IDS=xxxxxxxx.apps.googleusercontent.com
# Base URL used in invite links (defaults to the request origin)
PUBLIC_BASE_URL=https://wanderbar-api.vercel.app
